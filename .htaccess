RewriteEngine On

# 1. Route API requests cleanly to PHP backend
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/(.+)$ api/$1.php [QSA,L]

# 2. Specific route for /admin to load admin portal HTML
RewriteRule ^admin/?$ admin.html [L]
RewriteRule ^admin/(.*)$ admin/$1 [L]

# 3. Handle HTML extension hiding (e.g. /admin -> admin.html)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# 4. Fallback for SPA routing
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.html [QSA,L]

# Security & CORS Headers
<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
  Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-User-Id"
  Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
</IfModule>

# Options
Options -Indexes
AddDefaultCharset UTF-8
