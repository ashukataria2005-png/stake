RewriteEngine On

# 1. Direct /api/ calls to the PHP files
RewriteRule ^api/?$ api/index.php [QSA,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/(.+?)/?$ api/$1.php [QSA,L]

# 2. Specific routes for admin portal
RewriteRule ^admin/login/?$ admin/login.html [L]
RewriteRule ^admin/?$ admin.html [L]
RewriteRule ^admin/(.*)$ admin/$1 [L]

# 3. Handle HTML extension hiding (e.g. /admin -> admin.html)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# 4. Fallback for SPA routing (Strictly exclude /api requests from index.html fallback)
RewriteCond %{REQUEST_URI} !^/api
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.html [QSA,L]

# Security & CORS Headers
<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
  Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-User-Id"
  Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
</IfModule>

# Options
Options -Indexes
AddDefaultCharset UTF-8
